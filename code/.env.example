# Financial Advisor Bot — example environment configuration.
# Copy to `.env` and adjust. These override the defaults in advisor/config.py.
# No real broker/API keys belong here: this is a research/demo system only.

# Default local Ollama model (ADR-0001). The UI and the evaluation runner also
# know the short tags in advisor.config.ADVISOR_MODELS:
#   llama -> llama3.1:8b      qwen -> qwen3:8b      heuristic -> rule, no LLM
# Install a model with `ollama pull llama3.1:8b`.
OLLAMA_MODEL=llama3.1:8b

# Ollama server. Either the bare host or the OpenAI-compatible base with /v1;
# the recommender strips a trailing /v1 and talks to the native /api/chat
# endpoint (which lets it disable Qwen3's "thinking" mode).
OLLAMA_BASE_URL=http://localhost:11434/v1
